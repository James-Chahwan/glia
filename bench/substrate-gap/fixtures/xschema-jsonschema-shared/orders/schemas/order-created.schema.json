{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/order-created.schema.json",
  "title": "OrderCreated",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "total": { "type": "number" },
    "shipTo": { "$ref": "#/$defs/Address" }
  },
  "required": ["orderId"],
  "$defs": {
    "Address": {
      "type": "object",
      "properties": { "street": { "type": "string" } }
    }
  }
}
