{
  "framework": "scala-http",
  "language": "scala",
  "dirs": [
    "client",
    "server"
  ],
  "expect_nodes": [
    {
      "kind": "ENDPOINT",
      "name": "GET /api/users",
      "note": "ws.url(s\"http://users-svc/api/users/$id\").get() \u2014 host stripped, $id -> ${\u2026}, verb from the chain"
    },
    {
      "kind": "ENDPOINT",
      "name": "POST /api/users",
      "note": "ws.url(\"/api/users\").post(body)"
    },
    {
      "kind": "ENDPOINT",
      "name": "GET /api/orders",
      "note": "sttp basicRequest.get(uri\"http://orders-svc/api/orders\")"
    },
    {
      "kind": "ROUTE",
      "name": "/api/users",
      "note": "Go chi route (server, control)"
    }
  ],
  "expect_edges": [
    {
      "from": "fetchUser",
      "to": "GET /api/users",
      "category": "CALLS",
      "note": "enclosing method -> ENDPOINT"
    },
    {
      "from": "createUser",
      "to": "POST /api/users",
      "category": "CALLS",
      "note": "enclosing method -> ENDPOINT"
    },
    {
      "from": "POST /api/users",
      "to": "/api/users",
      "category": "HTTP_CALLS",
      "note": "pairs with the Go chi route"
    },
    {
      "from": "GET /api/orders",
      "to": "/api/orders",
      "category": "HTTP_CALLS",
      "note": "sttp endpoint pairs with the Go chi route"
    }
  ],
  "forbid": [
    {
      "kind": "ENDPOINT",
      "name": "user.",
      "note": "config.get(\"user.\" + id) is not an HTTP call"
    }
  ],
  "mechanism": "http_client",
  "cells": [
    "scala/http_client"
  ]
}
