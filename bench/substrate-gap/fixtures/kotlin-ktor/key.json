{
  "framework": "kotlin-ktor",
  "language": "kotlin",
  "dirs": ["."],
  "note": "A14.1 baseline: Ktor DSL routes. ROUTE nodes are already found by the Java parser's text scanner on Kotlin source — the Kotlin flip must not lose them.",
  "expect_nodes": [
    {"kind": "ROUTE",    "name": "GET /api/items", "note": "ALREADY FOUND via the text scanner — regression guard"},
    {"kind": "FUNCTION", "name": "itemRoutes",     "note": "extension fun — the HANDLED_BY target"},
    {"kind": "CLASS",    "name": "ItemStore",      "note": "ALREADY FOUND (plain `class X {` is java-parseable)"},
    {"kind": "METHOD",   "name": "all",            "note": "expression-body method"}
  ],
  "expect_edges": [
    {"from": "GET /api/items",  "to": "itemRoutes", "category": "HANDLED_BY", "note": "route -> enclosing declared function (Ktor handlers are anonymous lambdas)"},
    {"from": "POST /api/items", "to": "itemRoutes", "category": "HANDLED_BY", "note": "same enclosing function"},
    {"from": "itemRoutes",      "to": "all",        "category": "CALLS",      "note": "store.all() inside the lambda"},
    {"from": "app",             "to": "ItemStore",  "category": "IMPORTS",    "note": "import com.acme.store.ItemStore"}
  ]
}
