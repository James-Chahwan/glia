/target/
# Standalone bench sub-workspaces each emit their own target/ — these are
# separate from the engine's /target and let 3d-viewer balloon to 16GB
# untracked. Ignore them all. (2026-05-31)
bench/**/target/
# engram-export is excluded from the workspace (cross-repo engram-core dep), so
# it builds into its own target/ when run standalone.
engram-export/target/
# py builds a standalone target/ when compiled on its own (maturin / cargo -p).
py/target/
nodes.json
nodes.gmap

# Personal / local tooling
.venv-eval/
mempalace.yaml
entities.json

# SWE-bench experiment artifacts (gold patches, prompts, runlogs, model
# outputs) — regenerable research data; opt-in via `cargo build -p
# glia-latent` then re-run the pipeline.
bench/latent/out/

runpod.sh

# Cached graph data: the 0.5.0 layout `<repo>/.glia/graph/` written by
# `glia build`, the install-hooks hooks, `glia_py`'s `save_to_default()` and
# `load_from_gmap()` write-back, and `generate(incremental=True)`'s parse cache
# (plain `generate()` writes nothing since LD.2). Regenerable from source. The dir
# also ignores itself (its own `.gitignore` is `*`); these lines cover glia's
# own repo regardless. The rest of `.glia/` (overlay.toml, cells.jsonl) is
# checked-in input. Match at any depth (fixtures and crates get their own).
.glia/graph/
**/.glia/graph/
# The 0.4.x layout + parse cache (0.5.0 never reads or writes it).
.ai/repo-graph/
**/.ai/repo-graph/

# Python bytecode (eval harnesses under bench/).
__pycache__/

# Regenerable substrate-gap eval output — BLINDSPOTS.md is the committed summary.
bench/substrate-gap/results.jsonl

# Claude Code runtime lock (scheduled tasks); settings.local.json is ignored
# globally. Track .claude/commands/ but never the lock.
.claude/scheduled_tasks.lock
# Tier-4 external-doc snapshot (glia docs sync) — gitignored by default
.glia/docs-snapshot/

# Atlassian/Confluence API token for `glia docs sync` (Tier-4) — never commit
.env

# Gradle build caches, created when a fixture probe runs gradle
.gradle/
